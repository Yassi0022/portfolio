---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  onClick?: string;
}
const { href, variant = 'primary', size = 'md', class: className = '', type = 'button', disabled = false, onClick } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-medium rounded-xl transition-all duration-fast ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary disabled:opacity-50 disabled:cursor-not-allowed';

const variantClasses = {
  primary: 'bg-accent-primary text-bg-primary hover:bg-accent-primary/90 focus-visible:ring-accent-primary shadow-glow-sm hover:shadow-glow',
  secondary: 'bg-bg-tertiary text-text-primary border border-border hover:border-border-hover hover:bg-bg-secondary focus-visible:ring-border',
  ghost: 'bg-transparent text-text-secondary hover:text-text-primary hover:bg-bg-tertiary focus-visible:ring-border',
  outline: 'border-2 border-accent-primary text-accent-primary bg-transparent hover:bg-accent-primary hover:text-bg-primary focus-visible:ring-accent-primary',
};

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const classes = `${baseClasses} ${variantClasses[variant] || variantClasses.primary} ${sizeClasses[size] || sizeClasses.md} ${className}`;
---

{href ? (
  <a href={href} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled} onclick={onClick}>
    <slot />
  </button>
)}