---
interface Props {
  children: any;
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  onClick?: string;
}
const { children, href, variant = 'primary', size = 'md', class: className = '', type = 'button', disabled = false, onClick } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-fast ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary disabled:opacity-50 disabled:cursor-not-allowed';

const variantClasses = {
  primary: 'bg-accent-code text-bg-primary hover:bg-accent-code/90 focus-visible:ring-accent-code',
  secondary: 'bg-bg-tertiary text-text-primary border border-border hover:border-border-hover hover:bg-bg-secondary focus-visible:ring-border',
  ghost: 'bg-transparent text-text-secondary hover:text-text-primary hover:bg-bg-tertiary focus-visible:ring-border',
};

const sizeClasses = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-5 py-2.5 text-base',
  lg: 'px-7 py-3.5 text-lg',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{if (href) {
  <a href={href} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
} else {
  <button type={type} class={classes} disabled={disabled} onclick={onClick}>
    <slot />
  </button>
}}