    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-accent-green/10 text-accent-green mb-6 border border-accent-green/20">
        <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse" aria-hidden="true"></span> SOFTWARE · BACKEND · DATA · MACHINE LEARNING
