<section id="hero" class="relative pt-24 lg:pt-36 pb-16 lg:pb-28 overflow-hidden" aria-label="Introduction">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="max-w-3xl">
      <p class="label-eyebrow mb-4">Data Scientist — Data Analyst</p>
      <h1 class="section-heading mb-6">
        Making people data understandable.
      </h1>
      <p class="text-xl lg:text-2xl text-ink-secondary leading-relaxed mb-8">
        I use Python, SQL, statistics, and visual storytelling to understand people and performance. My work centers on HR analytics, workforce insights, and clear communication — turning complex data into decisions people can act on.
      </p>
      <div class="flex flex-wrap gap-3 mb-12">
        <a href="#projects" class="btn-primary">View case studies</a>
        <a href="#contact" class="btn-secondary">Get in touch</a>
      </div>
      <div class="flex flex-wrap gap-8 text-sm" aria-label="Evidence">
        <div>
          <span class="block font-display text-2xl font-bold text-ink">1,470</span>
          <span class="text-ink-muted">HR records analyzed</span>
        </div>
        <div>
          <span class="block font-display text-2xl font-bold text-ink">0.91</span>
          <span class="text-ink-muted">ROC-AUC (attrition)</span>
        </div>
        <div>
          <span class="block font-display text-2xl font-bold text-ink">47</span>
          <span class="text-ink-muted">Engineered features</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden lg:block absolute top-20 right-12 w-72 h-72 opacity-[0.08] pointer-events-none" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" stroke="#1F6B50" stroke-width="1">
      <circle cx="100" cy="100" r="80" />
      <circle cx="100" cy="100" r="50" />
      <line x1="100" y1="20" x2="100" y2="180" />
      <line x1="20" y1="100" x2="180" y2="100" />
    </svg>
  </div>
</section>
