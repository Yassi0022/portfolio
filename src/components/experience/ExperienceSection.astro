---
import { EXPERIENCE } from '@/data/constants';
---

<section id="experience" class="section bg-bg-secondary relative overflow-hidden" aria-labelledby="experience-heading">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent-secondary/3 to-transparent" aria-hidden="true" />
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27 opacity=%270.015%27/%3E%3C/svg%27')]" aria-hidden="true" />

  <div class="container relative">
    <header class="section-header animate-fade-in">
      <p class="section-label">Professional Journey</p>
      <h2 id="experience-heading" class="section-title">Experience</h2>
      <p class="section-subtitle">
        8+ years building production systems at scale — from high-throughput backends to end-to-end ML platforms.
      </p>
    </header>

    <div class="relative max-w-4xl mx-auto space-y-8">
      {EXPERIENCE.map((exp, index) => (
        <article key={exp.id} class="card-glass border border-white/10 bg-slate-900/50 backdrop-blur-md p-6 sm:p-8 rounded-2xl hover:border-accent-primary/40 transition-all duration-slow group relative">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-border/40">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="badge bg-accent-primary/15 text-accent-primary border border-accent-primary/30 text-xs font-medium">
                  {exp.type === 'full-time' ? 'Full-time' : exp.type}
                </span>
                <span class="badge bg-bg-tertiary text-text-muted border border-border text-xs font-mono">
                  {exp.period}
                </span>
              </div>
              <h3 class="font-display text-xl sm:text-2xl font-bold text-text-primary group-hover:text-accent-primary transition-colors">
                {exp.role}
              </h3>
              <p class="text-accent-secondary font-medium mt-0.5">{exp.company}</p>
            </div>
            <div class="text-text-muted text-xs sm:text-sm flex items-center gap-1.5 shrink-0 self-start md:self-center bg-bg-tertiary/60 px-3 py-1.5 rounded-lg border border-border/30">
              <svg class="w-4 h-4 shrink-0 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {exp.location}
            </div>
          </div>

          <ul class="space-y-3 mb-6" role="list" aria-label="Key achievements">
            {exp.highlights.map((highlight, i) => (
              <li key={i} class="flex items-start gap-3 text-text-secondary group-hover:text-text-primary transition-colors">
                <svg class="w-5 h-5 shrink-0 mt-0.5 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="leading-relaxed text-sm sm:text-base">{highlight}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2 mb-6" role="list" aria-label="Technologies used">
            {exp.technologies.map((tech) => (
              <span key={tech} class="badge bg-bg-tertiary text-text-secondary border border-border text-xs group-hover:text-accent-primary group-hover:border-accent-primary/30 transition-colors" role="listitem">
                {tech}
              </span>
            ))}
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-border/40">
            {exp.metrics.map((metric, i) => (
              <div key={i} class="text-center p-3 bg-bg-tertiary/60 rounded-xl border border-border/30">
                <div class="font-display text-xl sm:text-2xl font-bold text-accent-primary">{metric.value}</div>
                <div class="text-text-muted text-[10px] sm:text-xs font-mono tracking-wider mt-0.5">{metric.label}</div>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>