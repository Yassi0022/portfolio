---
import { EXPERIENCE } from '@/data/constants';
---

<section id="experience" className="section bg-bg-secondary relative overflow-hidden" aria-labelledby="experience-heading">
  <div className="absolute inset-0 bg-gradient-to-b from-transparent via-accent-secondary/3 to-transparent" aria-hidden="true" />
  <div className="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27 opacity=%270.015%27/%3E%3C/svg%27')" aria-hidden="true" />

  <div className="container relative">
    <header className="section-header animate-fade-in">
      <p className="section-label">Professional Journey</p>
      <h2 id="experience-heading" className="section-title">Experience</h2>
      <p className="section-subtitle">
        8+ years building production systems at scale — from high-throughput backends to end-to-end ML platforms.
      </p>
    </header>

    <div className="relative max-w-4xl mx-auto">
      <div className="absolute left-1/2 top-0 bottom-0 w-1 -translate-x-1/2 bg-gradient-to-b from-transparent via-accent-primary/30 to-transparent" aria-hidden="true" />

      {EXPERIENCE.map((exp, index) => (
        <article key={exp.id} className="relative animate-fade-in stagger-1" style={{ animationDelay: `${index * 200}ms` }}>
          <div className="absolute left-1/2 top-8 -translate-x-1/2 w-4 h-4 rounded-full border-4 border-bg-secondary bg-accent-primary z-10" />
          <div className="absolute left-1/2 top-12 -translate-x-1/2 w-1 h-full bg-border/50" />

          <div className={`lg:w-1/2 lg:pr-12 lg:pl-4 ${index % 2 === 1 ? 'lg:ml-auto lg:pl-12 lg:pr-4' : ''} relative z-10 mb-16 last:mb-0`}>
            <div className="card-elevated p-6 sm:p-8 hover:shadow-elevated-lg transition-all duration-slow group">
              <div className="flex flex-wrap items-center gap-2 mb-4">
                <span className="badge bg-accent-primary/15 text-accent-primary border-accent-primary/30 text-xs font-medium">{exp.type === 'full-time' ? 'Full-time' : exp.type}</span>
                <span className="badge bg-bg-tertiary text-text-muted border-border text-xs font-mono">{exp.period}</span>
              </div>

              <h3 className="font-display text-xl sm:text-2xl font-bold text-text-primary mb-1">{exp.role}</h3>
              <p className="text-accent-secondary font-medium mb-1">{exp.company}</p>
              <p className="text-text-muted text-sm mb-6 flex items-center gap-1">
                <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {exp.location}
              </p>

              <ul className="space-y-3 mb-6" role="list" aria-label="Key achievements">
                {exp.highlights.map((highlight, i) => (
                  <li key={i} className="flex items-start gap-3 text-text-secondary group-hover:text-text-primary transition-colors">
                    <svg className="w-5 h-5 flex-shrink-0 mt-0.5 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                    </svg>
                    <span className="leading-relaxed">{highlight}</span>
                  </li>
                ))}
              </ul>

              <div className="flex flex-wrap gap-2 mb-6" role="list" aria-label="Technologies used">
                {exp.technologies.map((tech, i) => (
                  <span key={tech} className="badge bg-bg-tertiary text-text-secondary border-border text-xs group-hover:text-accent-primary group-hover:border-accent-primary/30 transition-colors" role="listitem">
                    {tech}
                  </span>
                ))}
              </div>

              <div className="grid grid-cols-2 gap-4 pt-4 border-t border-border/50">
                {exp.metrics.map((metric, i) => (
                  <div key={i} className="text-center p-3 bg-bg-tertiary/50 rounded-xl">
                    <div className="font-display text-2xl font-bold text-accent-primary">{metric.value}</div>
                    <div className="text-text-muted text-xs font-mono tracking-wider mt-0.5">{metric.label}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 1023px) {
    .lg\:w-1\/2 {
      width: 100%;
    }
    .lg\:ml-auto {
      margin-left: 0;
    }
    .lg\:pl-12, .lg\:pr-12, .lg\:pl-4, .lg\:pr-4 {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>