---
import { SOCIAL_LINKS, SITE_CONFIG } from '@/data/constants';
---

<footer class="border-t border-border bg-page" aria-label="Footer">
  <div class="max-w-content mx-auto px-6 lg:px-10 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-16">
      <div>
        <a href="/portfolio/" class="inline-block font-display text-xl font-bold text-ink mb-4 hover:text-accent-green transition-colors" aria-label="Homepage">{SITE_CONFIG.name}</a>
        <p class="text-sm text-ink-secondary leading-relaxed max-w-md">
          Data science, software engineering, and applied machine learning. Building reliable systems and turning complex problems into clear, useful solutions.
        </p>
      </div>

      <div>
        <h3 class="font-display text-base font-bold text-ink mb-4">Navigation</h3>
        <nav aria-label="Footer links">
          <ul class="space-y-2 text-sm">
            <li><a href="/portfolio/" class="text-ink-secondary hover:text-ink transition-colors">About</a></li>
            <li><a href="/portfolio/#projects" class="text-ink-secondary hover:text-ink transition-colors">Case Studies</a></li>
            <li><a href="/portfolio/#skills" class="text-ink-secondary hover:text-ink transition-colors">Skills</a></li>
            <li><a href="/portfolio/#contact" class="text-ink-secondary hover:text-ink transition-colors">Contact</a></li>
          </ul>
        </nav>
      </div>

      <div>
        <h3 class="font-display text-base font-bold text-ink mb-4">Connect</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="mailto:yassinehatouf@gmail.com" class="text-ink-secondary hover:text-ink transition-colors">yassinehatouf@gmail.com</a></li>
          <li><a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="text-ink-secondary hover:text-ink transition-colors">GitHub</a></li>
          <li><a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="text-ink-secondary hover:text-ink transition-colors">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-muted">
      <p>© {new Date().getFullYear()} Yassine Hatouf. All rights reserved.</p>
      <p>Built with Astro, React, Tailwind CSS</p>
    </div>
  </div>
</footer>
