---
interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: 'website' | 'article';
}
const { title, description, image, url, type = 'website' } = Astro.props;

const siteTitle = 'Yassine Hatouf — Data Scientist & Data Analyst';
const siteUrl = 'https://yassi0022.github.io/portfolio';
const defaultImage = '/portfolio/images/og-image.svg';
const twitterHandle = '@yassi_dev';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yassine Hatouf',
  alternateName: 'Yassi',
  jobTitle: 'Data Scientist & Data Analyst',
  url: siteUrl,
  sameAs: [
    'https://github.com/Yassi0022',
    'https://www.linkedin.com/in/yassine-hatouf',
  ],
  knowsAbout: [
    'Data Science', 'HR Analytics', 'Predictive Modeling',
    'Python', 'SQL', 'Statistics', 'XGBoost', 'SHAP', 'Visualization',
  ]
};
---

<title>{title} | {siteTitle}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image ? `/portfolio${image}` : defaultImage} />
<meta property="og:url" content={url || siteUrl} />
<meta property="og:site_name" content={siteTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image ? `/portfolio${image}` : defaultImage} />

<link rel="canonical" href={url || siteUrl} />
<link rel="sitemap" href="/portfolio/sitemap.xml" />
<link rel="robots" href="/portfolio/robots.txt" />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
