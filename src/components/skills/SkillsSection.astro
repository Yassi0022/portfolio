---
import { SKILL_CATEGORIES, SKILLS } from '@/data/skills';
---

<section id="skills" class="section-padding bg-page" aria-labelledby="skills-heading">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <header class="mb-14 lg:mb-20">
      <p class="label-eyebrow mb-3">Skills & Toolkit</p>
      <h2 id="skills-heading" class="section-heading mb-4">What I work with</h2>
      <p class="text-ink-secondary text-lg max-w-2xl leading-relaxed">
        A practical toolkit for data analysis, HR analytics, and engineering — focused on clarity, rigor, and reproducibility rather than decorative breadth.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {SKILL_CATEGORIES.map(cat => (
        <article class="card-surface">
          <h3 class="font-display text-xl font-bold text-ink mb-3">{cat.label}</h3>
          <p class="text-sm text-ink-secondary mb-5 leading-relaxed">{cat.description || ''}</p>
          <ul class="space-y-2.5" aria-label={`${cat.label} skills`}>
            {SKILLS.filter(s => s.category === cat.id).map(skill => (
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-green mt-2 shrink-0" aria-hidden="true" />
                <div>
                  <span class="text-sm font-medium text-ink">{skill.name}</span>
                  <span class="text-xs text-ink-muted block">{skill.description}</span>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-12 lg:mt-16 p-6 bg-surface-subtle border border-border rounded-2xl">
      <h3 class="font-display text-lg font-bold text-ink mb-3">Analytical Approach</h3>
      <p class="text-sm text-ink-secondary leading-relaxed max-w-3xl">
        I start with a clear business or research question, validate the data source, build reproducible analysis pipelines in Python and SQL, and present findings with charts, written context, and explicit limitations. Every result includes the assumptions behind it.
      </p>
    </div>
  </div>
</section>
