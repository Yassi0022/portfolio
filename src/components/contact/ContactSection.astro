---
import { SITE_CONFIG, SOCIAL_LINKS } from '@/data/constants';
---

<section id="contact" className="section relative overflow-hidden" aria-labelledby="contact-heading">
  <div className="absolute inset-0 bg-gradient-to-br from-accent-primary/5 via-transparent to-accent-tertiary/5" aria-hidden="true" />
  <div className="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27 opacity=%270.02%27/%3E%3C/svg%27')" aria-hidden="true" />
  <div className="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-accent-primary/10 via-transparent to-transparent rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2" style="width: 600px; height: 600px;" aria-hidden="true" />
  <div className="absolute bottom-0 right-0 w-full h-full bg-gradient-to-tl from-accent-tertiary/10 via-transparent to-transparent rounded-full blur-3xl translate-x-1/2 translate-y-1/2" style="width: 500px; height: 500px;" aria-hidden="true" />

  <div className="container relative">
    <div className="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <div className="lg:pr-8">
        <header className="section-header text-left animate-fade-in">
          <p className="section-label">Get In Touch</p>
          <h2 id="contact-heading" className="section-title text-left">Let's Work Together</h2>
          <p className="section-subtitle text-left max-w-none mx-0">
            I'm always interested in challenging problems at the intersection of data, ML, and backend engineering.
            Whether it's building MLOps pipelines, designing scalable architectures, or uncovering insights from complex datasets.
          </p>
        </header>

        <div className="space-y-6 mt-8 animate-slide-up stagger-1">
          <a href={`mailto:${SITE_CONFIG.email}`} className="group flex items-center gap-4 p-5 bg-bg-card border border-border rounded-2xl hover:border-accent-primary/50 hover:bg-bg-elevated transition-all duration-slow">
            <div className="w-12 h-12 rounded-xl bg-accent-primary/15 flex items-center justify-center group-hover:bg-accent-primary/25 group-hover:scale-105 transition-all duration-300">
              <svg className="w-6 h-6 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p className="text-text-muted text-sm font-medium">Email</p>
              <p className="text-text-primary font-medium">{SITE_CONFIG.email}</p>
            </div>
          </a>

          <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" className="group flex items-center gap-4 p-5 bg-bg-card border border-border rounded-2xl hover:border-accent-secondary/50 hover:bg-bg-elevated transition-all duration-slow">
            <div className="w-12 h-12 rounded-xl bg-accent-secondary/15 flex items-center justify-center group-hover:bg-accent-secondary/25 group-hover:scale-105 transition-all duration-300">
              <svg className="w-6 h-6 text-accent-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <p className="text-text-muted text-sm font-medium">GitHub</p>
              <p className="text-text-primary font-medium">github.com/Yassi0022</p>
            </div>
          </a>

          <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" className="group flex items-center gap-4 p-5 bg-bg-card border border-border rounded-2xl hover:border-accent-tertiary/50 hover:bg-bg-elevated transition-all duration-slow">
            <div className="w-12 h-12 rounded-xl bg-accent-tertiary/15 flex items-center justify-center group-hover:bg-accent-tertiary/25 group-hover:scale-105 transition-all duration-300">
              <svg className="w-6 h-6 text-accent-tertiary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <p className="text-text-muted text-sm font-medium">LinkedIn</p>
              <p className="text-text-primary font-medium">yassine-hatouf</p>
            </div>
          </a>
        </div>

        <div className="mt-12 pt-8 border-t border-border/30 animate-fade-in stagger-2">
          <p className="text-text-secondary text-sm mb-4">Currently open to:</p>
          <div className="flex flex-wrap gap-2">
            <span className="badge bg-accent-primary/15 text-accent-primary border-accent-primary/30">Senior ML Engineer</span>
            <span className="badge bg-accent-secondary/15 text-accent-secondary border-accent-secondary/30">MLOps Engineer</span>
            <span className="badge bg-accent-tertiary/15 text-accent-tertiary border-accent-tertiary/30">Backend Engineer</span>
            <span className="badge bg-accent-warn/15 text-accent-warn border-accent-warn/30">Staff Engineer</span>
            <span className="badge bg-bg-tertiary text-text-muted border-border">Consulting</span>
          </div>
        </div>
      </div>

      <div className="relative">
        <div className="card-elevated p-6 sm:p-8 relative overflow-hidden">
          <form className="space-y-5" action="https://formspree.io/f/your-form-id" method="POST">
            <div className="grid sm:grid-cols-2 gap-5">
              <div>
                <label htmlFor="name" className="label">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  className="input"
                  placeholder="Yassine Hatouf"
                  required
                />
              </div>
              <div>
                <label htmlFor="email" className="label">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  className="input"
                  placeholder="you@example.com"
                  required
                />
              </div>
            </div>

            <div>
              <label htmlFor="subject" className="label">Subject</label>
              <select id="subject" name="subject" className="input" required>
                <option value="">Select a topic</option>
                <option value="mlops">MLOps & ML Engineering</option>
                <option value="backend">Backend Engineering</option>
                <option value="data">Data Engineering</option>
                <option value="consulting">Consulting / Advisory</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label htmlFor="message" className="label">Message</label>
              <textarea
                id="message"
                name="message"
                rows={5}
                className="input resize-none"
                placeholder="Tell me about your project, challenges, or just say hello..."
                required
              ></textarea>
            </div>

            <button type="submit" className="btn-primary w-full sm:w-auto group">
              Send Message
              <svg className="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>

            <p className="text-text-muted text-xs text-center sm:text-left">
              By submitting this form, you agree to my privacy policy. No spam, ever.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>