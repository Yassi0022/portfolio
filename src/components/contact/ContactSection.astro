---
import { SITE_CONFIG, SOCIAL_LINKS } from '@/data/constants';
---

<section id="contact" class="section-padding bg-page" aria-labelledby="contact-heading">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <p class="label-eyebrow mb-3">Contact</p>
        <h2 id="contact-heading" class="section-heading mb-6">Let's talk</h2>
        <p class="text-ink-secondary leading-relaxed mb-8 max-w-md">
          I'm open to collaboration, research discussions, or hiring conversations. Reach out directly via email or connect on LinkedIn and GitHub.
        </p>

        <a href={`mailto:${SITE_CONFIG.email}`} class="btn-primary inline-flex mb-3">Email me — {SITE_CONFIG.email}</a>
        <p class="text-xs text-ink-muted">Expected response within 1–2 business days.</p>

        <div class="flex gap-4 mt-8">
          <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-ink-secondary hover:text-ink transition-colors" aria-label="GitHub">GitHub</a>
          <a href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-ink-secondary hover:text-ink transition-colors" aria-label="LinkedIn">LinkedIn</a>
        </div>
      </div>

      <div class="bg-surface-subtle border border-border rounded-2xl p-8">
        <h3 class="font-display text-lg font-bold text-ink mb-4">What to include</h3>
        <ul class="space-y-3 text-sm text-ink-secondary">
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-accent-green mt-1.5 shrink-0" aria-hidden="true" />A brief description of the project or opportunity</li>
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-accent-green mt-1.5 shrink-0" aria-hidden="true" />Timeline and expected deliverables (if relevant)</li>
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-accent-green mt-1.5 shrink-0" aria-hidden="true" />Whether this is full-time, contract, or research collaboration</li>
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-accent-green mt-1.5 shrink-0" aria-hidden="true" />Any relevant context (dataset size, team structure, tech stack)</li>
        </ul>
      </div>
    </div>
  </div>
</section>
