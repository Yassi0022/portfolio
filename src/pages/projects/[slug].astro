---
import { PROJECTS, getProjectBySlug } from '@/data/projects';
import Layout from '@/components/layout/Layout.astro';

export async function getStaticPaths() {
  return PROJECTS.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Yassine Hatouf`} description={project.shortDescription} image="/portfolio/images/og-image.svg">
  <main class="min-h-screen">
    <header class="pt-32 pb-12 lg:pt-40 lg:pb-16 bg-page">
      <div class="max-w-content mx-auto px-6 lg:px-10">
        <a href="/portfolio/#projects" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink mb-6 transition-colors">← Back to case studies</a>
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold uppercase tracking-wide bg-accent-green/10 text-ink">Case Study</span>
          <span class="text-xs text-ink-muted">{project.stack.slice(0, 4).join(' · ')}</span>
        </div>
        <h1 class="font-display text-3xl lg:text-5xl font-bold text-ink tracking-tight mb-6">{project.title}</h1>
        <p class="text-lg lg:text-xl text-ink-secondary leading-relaxed max-w-3xl">{project.longDescription}</p>
      </div>
    </header>

    <div class="max-w-content mx-auto px-6 lg:px-10 pb-20">
      <!-- Illustrative visual summary -->
      <section class="mb-16" aria-label="Illustrative project summary">
        <figure class="bg-surface border border-border rounded-2xl overflow-hidden shadow-sm">
          <img
            src={project.thumbnail ? `/portfolio${project.thumbnail}` : `/portfolio/images/projects/${project.slug}.svg`}
            alt={`Illustrative analytical summary for ${project.title} — project architecture and key metrics visualization`}
            loading="lazy"
            class="w-full h-auto max-h-[420px] object-cover"
          />
          <figcaption class="px-6 py-4 text-xs text-ink-muted bg-surface-subtle border-t border-border">
            Illustrative analytical summary for {project.title}. This visual represents verified project structure, metrics, and architecture from the repository. It is not a screenshot of a live production system or client environment.
          </figcaption>
        </figure>
      </section>

      <!-- Metrics -->
      {project.keyMetrics && project.keyMetrics.length > 0 && (
        <section class="mb-16" aria-label="Key metrics">
          <h2 class="font-display text-2xl font-bold text-ink mb-6">Key Metrics</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {project.keyMetrics.map(metric => (
              <div class="bg-surface border border-border rounded-xl p-5">
                <div class="font-display text-2xl font-bold text-ink mb-1">{metric.value}</div>
                <div class="text-sm font-medium text-ink">{metric.label}</div>
                <div class="text-xs text-ink-muted mt-1">{metric.description}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Approach -->
      {project.pipelines && project.pipelines.length > 0 && (
        <section class="mb-16" aria-label="Approach">
          <h2 class="font-display text-2xl font-bold text-ink mb-6">Analytical Approach</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {project.pipelines.map(stage => (
              <div class="bg-surface-subtle border border-border rounded-xl p-6">
                <h3 class="font-display text-lg font-bold text-ink mb-2">{stage.name}</h3>
                <p class="text-sm text-ink-secondary leading-relaxed mb-4">{stage.description}</p>
                <div class="flex flex-wrap gap-2">
                  {stage.technologies.map(t => (
                    <span class="text-[11px] font-mono text-ink-muted bg-white border border-border rounded px-2 py-0.5">{t}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Architecture -->
      {project.architectureDiagram && (
        <section class="mb-16" aria-label="Architecture">
          <h2 class="font-display text-2xl font-bold text-ink mb-6">Architecture</h2>
          <div class="bg-surface-subtle border border-border rounded-xl p-6 overflow-x-auto">
            <pre class="font-mono text-sm text-ink-secondary whitespace-pre-wrap">{project.architectureDiagram}</pre>
          </div>
        </section>
      )}

      <!-- Caveats -->
      <section class="mb-16 bg-amber-50/60 border border-amber-200/40 rounded-xl p-6" aria-label="Limitations">
        <h2 class="font-display text-xl font-bold text-ink mb-3">Limitations & Caveats</h2>
        <ul class="list-disc list-inside text-sm text-ink-secondary leading-relaxed space-y-1.5">
          <li>Results reflect the IBM public dataset; generalization to other organizations requires additional validation.</li>
          <li>Temporal validation was limited; future performance may vary as workforce dynamics change.</li>
          <li>Estimated business impact ($2.3M) is a model-based projection, not a verified client outcome.</li>
          <li>Model predictions should be combined with fairness auditing before deployment in hiring or retention decisions.</li>
          <li>SHAP values provide association, not causal inference; additional experimental design is recommended for policy evaluation.</li>
        </ul>
      </section>

      <!-- Links -->
      <div class="flex gap-4">
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm">View source on GitHub</a>
        {project.demoUrl ? (
          <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">Live demo <span class="text-[10px] font-mono uppercase tracking-wide ml-1 opacity-70">placeholder</span></a>
        ) : null}
      </div>
    </div>
  </main>
</Layout>
