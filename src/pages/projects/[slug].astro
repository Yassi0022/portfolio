---
import { PROJECTS, getProjectBySlug } from '@/data/projects';
import Layout from '@/components/layout/Layout.astro';
import ProjectCardInteractive from '@/components/projects/ProjectCardInteractive.tsx';
import CaseStudyModal from '@/components/projects/CaseStudyModal.tsx';
import { getFeaturedProjects } from '@/data/projects';

export async function getStaticPaths() {
  return PROJECTS.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: typeof PROJECTS[0];
}

const { project } = Astro.props;
const featuredProjects = getFeaturedProjects().filter(p => p.slug !== project.slug);

const typeConfig = {
  mlops: { label: 'MLOps', badge: 'badge-tertiary', accent: 'accent-tertiary' },
  'data-science': { label: 'Data Science', badge: 'badge-secondary', accent: 'accent-secondary' },
  fullstack: { label: 'Full Stack', badge: 'badge-primary', accent: 'accent-primary' },
}[project.type];
---

<Layout title={`${project.title} | Yassine Hatouf`} description={project.shortDescription} image="/images/og-image.svg">
  <script>
    window.currentProject = null;
    window.openCaseStudy = function(proj) {
      window.currentProject = proj;
      const event = new CustomEvent('open-case-study', { detail: proj });
      window.dispatchEvent(event);
    };
  </script>

  <article class="min-h-screen">
    <header class="relative min-h-[60vh] flex items-end overflow-hidden">
      <div class={`absolute inset-0 bg-gradient-to-br from-${typeConfig.accent}/5 via-transparent to-transparent z-0`} />
      <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27 opacity=%270.03%27/%3E%3C/svg%27')]" aria-hidden="true" />
      <div class={`absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gradient-to-br from-${typeConfig.accent}/10 to-transparent rounded-full blur-3xl -translate-y-1/2`} aria-hidden="true" />

      <div class="relative z-10 container py-20 pb-16">
        <div class="max-w-4xl">
          <span class={`${typeConfig.badge} mb-4 animate-slide-up`}>
            {typeConfig.label}
          </span>
          <h1 class="font-display text-display-lg lg:text-display-xl font-bold leading-tight mb-6 animate-slide-up stagger-1">
            {project.title}
          </h1>
          <p class="text-body-lg text-text-secondary max-w-2xl mb-8 animate-slide-up stagger-2">
            {project.longDescription}
          </p>

          <div class="flex flex-wrap gap-3 mb-8 animate-slide-up stagger-3" role="list" aria-label="Tech stack">
            {project.stack.map((tech, i) => (
              <span key={tech} class={`badge ${['badge-primary', 'badge-secondary', 'badge-tertiary'][i % 3]}`} role="listitem">
                {tech}
              </span>
            ))}
          </div>

          <div class="flex flex-wrap gap-4 animate-slide-up stagger-4">
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary group">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              View on GitHub
            </a>
            {project.demoUrl && (
              <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                Live Demo
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
            <button
              class="btn-outline"
              onclick={`window.openCaseStudy && window.openCaseStudy(${JSON.stringify(project).replace(/"/g, '&quot;')})`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Read Case Study
            </button>
          </div>
        </div>
      </div>

      <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-bg-primary to-transparent z-10 pointer-events-none" aria-hidden="true" />
    </header>

    {project.keyMetrics.length > 0 && (
      <section class="section bg-bg-secondary relative overflow-hidden" aria-labelledby="metrics-heading">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent-primary/3 to-transparent" aria-hidden="true" />
        <div class="container relative">
          <header class="text-center mb-12 animate-fade-in">
            <h2 id="metrics-heading" class="font-display text-display-md font-bold mb-3">Key Metrics</h2>
            <p class="text-text-secondary max-w-2xl mx-auto">Measurable outcomes from production deployment</p>
          </header>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 animate-fade-in stagger-1">
            {project.keyMetrics.map((metric, i) => (
              <div key={i} class="card-elevated text-center group">
                <div class="text-3xl sm:text-4xl font-display font-bold text-accent-primary mb-1 group-hover:text-accent-secondary transition-colors">
                  {metric.value}
                </div>
                <div class="font-medium text-text-primary mb-1">{metric.label}</div>
                <div class="text-text-muted text-sm">{metric.description}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {project.architectureDiagram && (
      <section class="section relative overflow-hidden" aria-labelledby="architecture-heading">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent-secondary/3 to-transparent" aria-hidden="true" />
        <div class="container relative">
          <header class="text-center mb-12 animate-fade-in">
            <h2 id="architecture-heading" class="font-display text-display-md font-bold mb-3">System Architecture</h2>
            <p class="text-text-secondary max-w-2xl mx-auto">High-level data flow and component interactions</p>
          </header>
          <div class="card-elevated p-8 overflow-x-auto max-w-5xl mx-auto animate-slide-up">
            <pre class="font-mono text-sm text-text-secondary leading-relaxed whitespace-pre-wrap text-center">
              {project.architectureDiagram}
            </pre>
            <p class="text-text-muted text-xs mt-4 text-center">
              Mermaid diagram — render with Mermaid.js for visual diagram
            </p>
          </div>
        </div>
      </section>
    )}

    {project.pipelines && project.pipelines.length > 0 && (
      <section class="section bg-bg-secondary relative overflow-hidden" aria-labelledby="pipeline-heading">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent-tertiary/3 to-transparent" aria-hidden="true" />
        <div class="container relative">
          <header class="text-center mb-12 animate-fade-in">
            <h2 id="pipeline-heading" class="font-display text-display-md font-bold mb-3">Pipeline Stages</h2>
            <p class="text-text-secondary max-w-2xl mx-auto">End-to-end data and ML pipeline breakdown</p>
          </header>
          <div class="max-w-4xl mx-auto space-y-6 animate-fade-in stagger-1">
            {project.pipelines.map((stage, i) => (
              <div key={i} class="relative pl-8 pb-8 last:pb-0">
                <div class="absolute left-0 top-0 w-1 h-full bg-gradient-to-b from-accent-primary via-accent-secondary to-accent-tertiary rounded-full" />
                <div class="relative">
                  <div class="absolute left-0 top-0 w-4 h-4 rounded-full border-2 border-accent-primary bg-bg-primary z-10" />
                  <div class="card-elevated p-6 group">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="badge bg-accent-primary/15 text-accent-primary border-accent-primary/30">{i + 1}</span>
                      <h3 class="font-display text-xl font-bold text-text-primary group-hover:text-accent-primary transition-colors">{stage.name}</h3>
                    </div>
                    <p class="text-text-secondary mb-4">{stage.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {stage.technologies.map((tech: string) => (
                        <span key={tech} class="badge bg-bg-tertiary text-text-muted border-border text-xs">{tech}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section relative overflow-hidden" aria-labelledby="other-projects-heading">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent-primary/3 to-transparent" aria-hidden="true" />
      <div class="container relative">
        <header class="text-center mb-16 animate-fade-in">
          <h2 id="other-projects-heading" class="font-display text-display-md font-bold mb-4">Other Featured Projects</h2>
          <p class="text-text-secondary max-w-2xl mx-auto">More production-grade systems and applications</p>
        </header>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {featuredProjects.map((proj, index) => (
            <ProjectCardInteractive project={proj} index={index} client:visible />
          ))}
        </div>
      </div>
    </section>
  </article>

  <CaseStudyModal
    project={project}
    client:idle
    define:vars={{ project }}
  />
</Layout>