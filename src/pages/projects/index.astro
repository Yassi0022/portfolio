---
import Layout from '@/components/layout/Layout.astro';
import { PROJECTS } from '@/data/projects';
---

<Layout title="Projects | Yassine Hatouf" description="Selected projects demonstrating HR analytics, predictive modeling, and full-stack engineering." image="/portfolio/images/og-image.svg">
  <header class="pt-32 pb-12 max-w-content mx-auto px-6 lg:px-10">
    <p class="label-eyebrow mb-3">Case Studies</p>
    <h1 class="font-display text-4xl lg:text-5xl font-bold text-ink tracking-tight mb-4">Selected work</h1>
    <p class="text-lg text-ink-secondary max-w-2xl leading-relaxed">Predictive analytics, HR insights, and engineering foundations — with clear business context and documented limitations.</p>
  </header>

  <main class="max-w-content mx-auto px-6 lg:px-10 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {PROJECTS.map(project => (
        <article class="card-surface flex flex-col">
          <h2 class="font-display text-xl font-bold text-ink mb-2">{project.title}</h2>
          <p class="text-sm text-ink-secondary leading-relaxed mb-4">{project.shortDescription}</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {project.stack.slice(0, 5).map(s => (
              <span class="text-[11px] font-mono text-ink-muted bg-surface-subtle border border-border rounded px-2 py-0.5">{s}</span>
            ))}
          </div>
          <a href={`/portfolio/projects/${project.slug}`} class="text-sm font-medium text-accent-green hover:underline mt-auto">Read case study →</a>
        </article>
      ))}
    </div>
  </main>
</Layout>
